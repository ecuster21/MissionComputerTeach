{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "(gdb) Launch ROS2 Node",
            "type": "cppdbg",
            "request": "launch",
            // 关键修改：指向 install 目录下的可执行文件
            "program": "${workspaceFolder}/install/telemetry_telecommand/lib/telemetry_telecommand/telemetry_telecommand_node",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [
                // ROS2 调试必须加载环境变量，否则会找不到依赖
                {
                    "name": "LD_LIBRARY_PATH",
                    "value": "${workspaceFolder}/install/telemetry_telecommand/lib:${env:LD_LIBRARY_PATH}"
                },
                {
                    "name": "AMENT_PREFIX_PATH",
                    "value": "${workspaceFolder}/install"
                }
            ],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set Disassembly Flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}